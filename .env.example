# ══════════════════════════════════════════════════════════
# LifeOS — Environment untuk deploy VPS (docker-compose)
# Salin ke file ".env" di folder deploy, lalu isi nilainya.
# (install.sh membuat file ini otomatis dengan prompt interaktif)
# ══════════════════════════════════════════════════════════

# ── Auth login (WAJIB ganti — jangan pakai default!) ──
AUTH_USERNAME=admin
AUTH_PASSWORD=ganti-password-kuat-123
# Generate acak: openssl rand -hex 32
AUTH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── AI (opsional — kosongkan untuk mode heuristik/offline) ──
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
